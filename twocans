#!/usr/bin/env bash
#
# twocans — look after your family phone line.
#
#   ./twocans                 what it can do
#   ./twocans status          is everything working?
#   ./twocans logs [part]     follow what's happening: phone, web, transcription, database, pager, all
#   ./twocans backup          make a backup now
#   ./twocans backups         list the backups
#   ./twocans restore [name]  put a backup back
#   ./twocans export          your data in one zip: call log, contacts, voicemails, recordings
#   ./twocans version         what's installed, and whether there's a newer release
#   ./twocans update          update to the latest release
#   ./twocans report          a support report for a GitHub issue, private details removed
#   ./twocans reset-owner     locked out? reset the Owner account
#   ./twocans check           check software, ports, firewall and this machine
#   ./twocans uninstall       stop and remove twocans (your data is kept unless you say)
#
# Setting up is ./install.sh; this is for everything after.
#
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"
COMMAND=${1:-help}
[[ $# -gt 0 ]] && shift

ASSUME_YES=false; CHECK_ONLY=false
# shellcheck source=scripts/ui.sh
source scripts/ui.sh

GITHUB_REPO=$(git remote get-url origin 2>/dev/null | sed -nE 's#.*github\.com[:/]([^/]+/[^/.]+)(\.git)?$#\1#p' || true)
GITHUB_REPO=${GITHUB_REPO:-tombruton87/TwoCans}

# ------------------------------------------------------------------ helpers

# The container running the app. A development setup (compose.dev.yml) runs
# the same one, built here with the code in this folder mounted live.
APP=$(docker ps --format '{{.Names}}' 2>/dev/null | grep -x 'twocans-web' | head -1 || true)
DEV_SETUP=false
[[ -n "$APP" && "$(docker inspect -f '{{.Config.Image}}' "$APP" 2>/dev/null)" == twocans-web:dev ]] && DEV_SETUP=true

need_app() {
  [[ -n "$APP" ]] || die "twocans isn't running. Start it with: ./install.sh"
}

# Run one of the app's tools. With a terminal, it gets one too (for prompts).
app() {
  local flags=(-i)
  [[ -t 0 && -t 1 ]] && flags=(-it)
  docker exec "${flags[@]}" "$APP" php "/var/www/html/bin/$1" "${@:2}"
}
app_quiet() { docker exec -i "$APP" php "/var/www/html/bin/$1" "${@:2}"; }

# The app's own tools arrive with its image, so an older image may lack one.
need_tool() {
  docker exec "$APP" test -f "/var/www/html/bin/$1" 2>/dev/null && return 0
  local running; running=$(version_running)
  die "This needs a newer twocans than the one running${running:+ ($running)} — update with: ./twocans update"
}

# Turn "kind<TAB>text" lines from the app into the usual status lines.
render() {
  local kind text
  while IFS=$'\t' read -r kind text; do
    case "$kind" in
      section) section "$text" ;;
      ok) ok "$text" ;;
      warn) warn "$text" ;;
      bad) bad "$text" ;;
      note) note "$text" ;;
      file) RENDERED_FILE=$text ;;
      *) [[ -n "$kind$text" ]] && echo "  $kind${text:+ $text}" ;;
    esac
  done
}

header() { echo; echo "  ${coral}${bold}two${off}${teal}${bold}cans${off}  ${dim}$*${off}"; }

human_size() { awk -v b="$1" 'BEGIN { split("B KB MB GB TB", u); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ } printf (i == 1 ? "%d%s" : "%.1f%s"), b, u[i] }'; }

version_of_code() { tr -d ' \n' < backend/VERSION 2>/dev/null || echo unknown; }
version_running() { [[ -n "$APP" ]] && docker exec "$APP" cat /var/www/html/VERSION 2>/dev/null | tr -d ' \n' || true; }

# The newest release on GitHub, or nothing if it can't be reached.
latest_release() {
  curl -fsS --max-time 8 "https://api.github.com/repos/$GITHUB_REPO/releases/latest" 2>/dev/null \
    | grep -oE '"tag_name": *"[^"]+"' | head -1 | sed -E 's/.*"v?([^"]+)"$/\1/' || true
}

# True when version $1 is older than $2.
older() { [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" == "$1" ]]; }

# ------------------------------------------------------------------ commands

cmd_help() {
  header "look after your family phone line"
  echo
  local rows=(
    "status|is everything working?"
    "logs [part]|follow what's happening — phone, web, transcription, database, pager or all"
    "backup|make a backup now"
    "backups|list the backups"
    "restore [name]|put a backup back"
    "export|your data in one zip: call log, contacts, voicemails and recordings"
    "version|what's installed, and whether there's a newer release"
    "update|update to the latest release"
    "report|a support report for a GitHub issue, private details removed"
    "reset-owner|locked out? reset the Owner account"
    "check|check software, ports, firewall and this machine"
    "uninstall|stop and remove twocans — your data is kept unless you say"
  )
  local row
  for row in "${rows[@]}"; do
    printf "  ${teal}./twocans %-16s${off} %s\n" "${row%%|*}" "${row#*|}"
  done
  echo
  echo "  ${dim}Setting up for the first time is ./install.sh.${off}"
  echo
}

cmd_status() {
  header "status"
  section "Containers"
  local parts=(
    "twocans-asterisk|phone service"
    "twocans-mariadb|database"
    "twocans-transcriber|transcription"
    "twocans-whisper|speech-to-text"
    "twocans-pager|paging desk phones"
  )
  if $DEV_SETUP; then
    parts=("twocans-web|web app (development setup — the code in this folder)" "${parts[@]}")
  else
    parts=("twocans-web|web app" "${parts[@]}")
  fi
  local part name label state health started
  for part in "${parts[@]}"; do
    name=${part%%|*}; label=${part#*|}
    state=$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || echo missing)
    health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$name" 2>/dev/null || true)
    started=$(docker inspect -f '{{.State.StartedAt}}' "$name" 2>/dev/null || true)
    started=$(date -d "$started" '+%-d %b, %H:%M' 2>/dev/null || echo "$started")
    if [[ "$state" == running && "$health" != unhealthy ]]; then
      ok "$label — running since $started${health:+ ($health)}"
    elif [[ "$state" == missing ]]; then
      bad "$label — not there (run ./install.sh)"
    else
      bad "$label — ${health:-$state}"
    fi
  done

  # Where browsers find it: the .local name (when published) and the address.
  local env_name env_port env_ip url
  env_name=$(grep -E '^MDNS_NAME=' .env 2>/dev/null | cut -d= -f2- || true)
  env_port=$(grep -E '^HTTP_PORT=' .env 2>/dev/null | cut -d= -f2- || true); env_port=${env_port:-8083}
  env_ip=$(grep -E '^SIP_DOMAIN=' .env 2>/dev/null | cut -d= -f2- || true)
  section "Where to find it"
  [[ -n "$env_ip" ]] && ok "http://$env_ip:$env_port"
  if [[ -n "$env_name" ]]; then
    url="http://${env_name}.local:$env_port"
    if getent ahostsv4 "${env_name}.local" 2>/dev/null | awk '{print $1}' | grep -qx "$env_ip"; then
      ok "$url"
    elif grep -q "^# twocans (install.sh)$" /etc/avahi/hosts 2>/dev/null; then
      note "$url — announced; this machine can't look up .local names, so try it from a phone"
    else
      note "$url isn't set up — ./install.sh offers to"
    fi
  fi

  if [[ -z "$APP" ]]; then
    echo; warn "The app isn't running, so that's all there is to show."
    return
  fi
  if docker exec "$APP" test -f /var/www/html/bin/status.php 2>/dev/null; then
    app_quiet status.php | render
  else
    echo; warn "The rest of the status needs a newer twocans — update with: ./twocans update"
  fi
  echo
}

cmd_logs() {
  local part=${1:-}
  if [[ -z "$part" ]]; then
    if $CAN_PROMPT; then
      echo
      echo "  Which part?  1) phone  2) web  3) transcription  4) database  5) all"
      read -r -p "  Number [5]: " part < /dev/tty || part=""
      case "${part:-5}" in 1) part=phone ;; 2) part=web ;; 3) part=transcription ;; 4) part=database ;; *) part=all ;; esac
    else
      part=all
    fi
  fi
  local containers=()
  case "$part" in
    phone|asterisk) containers=(twocans-asterisk) ;;
    web|app) containers=(twocans-web) ;;
    transcription|transcriber|whisper) containers=(twocans-transcriber twocans-whisper) ;;
    database|db|mariadb) containers=(twocans-mariadb) ;;
    pager|paging) containers=(twocans-pager) ;;
    all) mapfile -t containers < <(docker ps --format '{{.Names}}' | grep '^twocans-' | sort) ;;
    *) die "No part called '$part' — try phone, web, transcription, database, pager or all." ;;
  esac
  ((${#containers[@]})) || die "twocans isn't running."
  echo "  ${dim}Following ${part} — Ctrl+C to stop.${off}"
  if (( ${#containers[@]} == 1 )); then
    exec docker logs -f --tail 100 "${containers[0]}"
  fi
  # Several at once, each line marked with where it came from.
  local c pids=()
  for c in "${containers[@]}"; do
    docker logs -f --tail 30 "$c" 2>&1 | sed -u "s/^/${teal}${c#twocans-}${off} │ /" &
    pids+=($!)
  done
  trap 'kill "${pids[@]}" 2>/dev/null; exit 0' INT TERM
  wait
}

cmd_backup() {
  need_app; need_tool backup.php
  header "backup"
  echo
  quietly "Making a backup" app_quiet backup.php
  local name
  name=$(grep -oE 'twocans-[0-9-]+\.tgz' "$LOG" | tail -1 || true)
  [[ -n "$name" ]] || die "The backup didn't say where it went: $(cat "$LOG")"
  local size
  size=$(app_quiet backup.php --tsv | awk -F'\t' -v n="$name" '$1 == n {print $2}')
  ok "backup made — $(human_size "${size:-0}")"
  echo
  box "storage/backups/$name" "" "Keep a copy somewhere else too - another" "computer, a USB stick or cloud storage."
  echo
}

cmd_backups() {
  need_app; need_tool backup.php
  header "backups"
  section "In storage/backups"
  local rows
  rows=$(app_quiet backup.php --tsv)
  if [[ -z "$rows" ]]; then
    warn "no backups yet — make one with: ./twocans backup"
    echo; return
  fi
  local i=0 name size when
  while IFS=$'\t' read -r name size when; do
    i=$((i + 1))
    printf "  ${teal}%2d${off}  %-36s %9s   %s\n" "$i" "$name" "$(human_size "$size")" "$when"
  done <<< "$rows"
  echo
}

cmd_restore() {
  need_app; need_tool restore.php
  header "restore"
  local name=${1:-} rows
  rows=$(app_quiet backup.php --tsv)
  [[ -n "$rows" ]] || die "There are no backups in storage/backups to restore."
  if [[ -z "$name" ]]; then
    $CAN_PROMPT || die "Say which backup: ./twocans restore <name> (see ./twocans backups)"
    cmd_backups
    local pick
    read -r -p "  Which one? Number [1]: " pick < /dev/tty || pick=""
    name=$(sed -n "${pick:-1}p" <<< "$rows" | cut -f1)
    [[ -n "$name" ]] || die "There's no number ${pick}."
  fi
  grep -q "^${name}"$'\t' <<< "$rows" || die "No backup called $name — see ./twocans backups"

  section "What's in $name"
  app_quiet restore.php --dry-run "$name" | sed 's/^/  /'
  echo
  warn "Restoring replaces the database and files with this backup."
  note "Everything since it was made is lost — though a safety copy of the current"
  note "database is written first."
  confirm "Restore $name?" n || { echo "  Nothing changed."; exit 0; }
  # restore.php asks for RESTORE to be typed, as a last check.
  app restore.php "$name"
}

cmd_export() {
  need_app; need_tool export.php
  header "export"
  section "Gathering your data"
  RENDERED_FILE=""
  # Not a pipe: render has to set RENDERED_FILE in this shell.
  render < <(app_quiet export.php "$@")
  [[ -n "$RENDERED_FILE" ]] || die "The export didn't finish."
  # Standard installs share storage/ with the container; if this one doesn't,
  # copy the zip out.
  mkdir -p storage/exports
  if [[ ! -f "storage/exports/$RENDERED_FILE" ]]; then
    docker cp "$APP:/var/lib/twocans/exports/$RENDERED_FILE" "storage/exports/$RENDERED_FILE" >/dev/null
    docker exec "$APP" rm -f "/var/lib/twocans/exports/$RENDERED_FILE"
  fi
  chmod 600 "storage/exports/$RENDERED_FILE" 2>/dev/null || true
  echo
  box "storage/exports/$RENDERED_FILE" "" "It holds recordings of your family:" "keep it somewhere private."
  echo
}

cmd_version() {
  header "version"
  echo
  local code running latest
  code=$(version_of_code)
  running=$(version_running)
  echo "  This folder:  ${bold}${code}${off}"
  if [[ -n "$running" ]]; then
    echo "  Running:      ${bold}${running}${off}$($DEV_SETUP && echo " ${dim}(development setup — the code in this folder)${off}")"
  else
    echo "  Running:      ${dim}not running${off}"
  fi
  latest=$(latest_release)
  if [[ -z "$latest" ]]; then
    echo "  Latest:       ${dim}couldn't reach GitHub${off}"
  else
    echo "  Latest:       ${bold}${latest}${off}  ${dim}github.com/$GITHUB_REPO/releases${off}"
    echo
    if older "${running:-$code}" "$latest"; then
      warn "twocans $latest is out — update with: ./twocans update"
    else
      ok "up to date"
    fi
  fi
  echo
}

cmd_update() {
  header "update"
  if $DEV_SETUP; then
    warn "This is a development setup (the code in this folder runs as it is)."
    note "Update it with git yourself, then: docker compose -f compose.yaml -f compose.dev.yml up -d --build"
    exit 0
  fi
  [[ -d .git ]] || die "This folder isn't a git clone, so it can't update itself. Clone it again from github.com/$GITHUB_REPO"

  # The voicemail config is written by the app, so it always differs from the
  # repo's copy; it's written again after the update. Anything else changed by
  # hand has to be sorted out first, rather than lost.
  git checkout -- docker/asterisk/etc/voicemail.conf 2>/dev/null || true
  # An install from 0.1.1 or earlier wrote Asterisk's passwords into these; the
  # installer keeps them in docker/asterisk/etc/secrets/ now, so put them back.
  local conf
  for conf in docker/asterisk/etc/ari.conf docker/asterisk/etc/manager.conf; do
    grep -qE '^(password|secret) = ' "$conf" 2>/dev/null && git checkout -- "$conf" 2>/dev/null || true
  done
  local changed
  changed=$(git status --porcelain --untracked-files=no 2>/dev/null || true)
  if [[ -n "$changed" ]]; then
    bad "Files in this folder have been changed by hand:"
    sed 's/^/      /' <<< "$changed"
    note "Undo them with: git checkout -- <file>, or keep them with: git stash — then run this again."
    exit 1
  fi
  local running latest
  running=$(version_running); running=${running:-$(version_of_code)}
  echo
  latest=$(latest_release)
  if [[ -z "$latest" ]]; then
    warn "Couldn't reach GitHub to see what's newest — updating to whatever is there."
  elif ! older "$running" "$latest"; then
    ok "twocans $running is the latest — nothing to update."
    confirm "Re-run the update anyway (fetch images, check everything)?" n || { echo; exit 0; }
  else
    ok "twocans $latest is out (you have $running)"
    note "What's new: https://github.com/$GITHUB_REPO/releases"
  fi

  confirm "Update now?" y || { echo "  Nothing changed."; exit 0; }
  quietly "Fetching the new version" git pull --ff-only
  ok "code updated to $(version_of_code)"
  echo
  # The installer does the rest: images, database, config — asking before
  # cutting off a call in progress.
  exec ./install.sh
}

cmd_report() {
  header "report"
  mkdir -p storage/reports
  local out raw
  out="storage/reports/twocans-report-$(date +%Y%m%d-%H%M).txt"
  raw=$(mktemp)
  {
    echo "twocans support report — $(date '+%Y-%m-%d %H:%M %Z')"
    echo "Private details (passwords, names, numbers, emails, domain, public IP) are removed."
    echo
    echo "== Versions"
    echo "twocans (folder): $(version_of_code)   running: $(version_running)   latest: $(latest_release)"
    echo "setup: $($DEV_SETUP && echo development || echo standard)"
    echo "OS: $(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME")  kernel: $(uname -r)  arch: $(uname -m)"
    echo "docker: $(docker --version 2>/dev/null)   compose: $(docker compose version --short 2>/dev/null)"
    echo
    echo "== Settings in .env (names only)"
    grep -oE '^[A-Z_]+=' .env 2>/dev/null | tr -d '=' | tr '\n' ' '; echo
    echo
    echo "== Containers"
    docker ps -a --filter name=twocans- --format '{{.Names}}  {{.Status}}  {{.Image}}' 2>/dev/null
    echo
    echo "== Installer checks (./install.sh --check)"
    ./install.sh --check --yes 2>&1 | sed '1,/Checking only/d'
    echo
    if [[ -n "$APP" ]]; then
      echo "== Status"
      app_quiet status.php 2>&1 | tr '\t' ' '
      echo
      echo "== System checks"
      app_quiet check-asterisk.php 2>&1
      echo
    fi
    if docker ps --format '{{.Names}}' | grep -qx twocans-asterisk; then
      echo "== Asterisk"
      docker exec twocans-asterisk asterisk -rx 'core show version' 2>&1
      docker exec twocans-asterisk asterisk -rx 'pjsip show transports' 2>&1 | grep -E 'Transport:|^ *[0-9]' | head -20
      docker exec twocans-asterisk asterisk -rx 'pjsip show registrations' 2>&1 | head -20
      docker exec twocans-asterisk asterisk -rx 'core show channels count' 2>&1
      echo
    fi
    local last_install
    last_install=$(ls -t storage/reports/install-*.log 2>/dev/null | head -1 || true)
    if [[ -n "$last_install" ]]; then
      echo "== The last install: $last_install (last 200 lines)"
      tail -200 "$last_install"
      echo
    fi
    local c
    for c in $(docker ps -a --format '{{.Names}}' | grep '^twocans-' | sort); do
      echo "== Log: $c (last 150 lines)"
      docker logs --tail 150 "$c" 2>&1
      echo
    done
  } > "$raw" 2>&1 &
  local pid=$!
  if $TTY; then spinning "Gathering versions, checks and logs" "$pid"; fi
  wait "$pid" || true

  if [[ -n "$APP" ]] && docker exec "$APP" test -f /var/www/html/bin/redact.php 2>/dev/null; then
    app_quiet redact.php < "$raw" > "$out"
    ok "private details removed"
  else
    # No app to look up names with: take out .env's values at least.
    cp "$raw" "$out"
    while IFS='=' read -r key value; do
      [[ "$key" =~ (PASSWORD|KEY|TOKEN)$ && ${#value} -ge 4 ]] && sed -i "s|${value//|/\\|}|[secret]|g" "$out"
    done < <(grep -E '^[A-Z_]+=' .env 2>/dev/null || true)
    warn "twocans isn't running, so only passwords were removed — names and numbers may remain"
  fi
  rm -f "$raw"
  chmod 600 "$out"
  ok "$(wc -l < "$out") lines"
  echo
  box "$out" "" "Read it through before you share it, then attach" "it to an issue: github.com/$GITHUB_REPO/issues"
  echo
}

# ---------------------------------------------------------------------- run
case "$COMMAND" in
  help|-h|--help) cmd_help ;;
  status) cmd_status ;;
  logs|log) cmd_logs "$@" ;;
  backup) cmd_backup ;;
  backups) cmd_backups ;;
  restore) cmd_restore "$@" ;;
  export) cmd_export "$@" ;;
  version|--version|-v) cmd_version ;;
  update|upgrade) cmd_update ;;
  report) cmd_report ;;
  reset-owner) exec ./install.sh --reset-owner ;;
  check) exec ./install.sh --check ;;
  uninstall) exec ./install.sh --uninstall ;;
  install) exec ./install.sh "$@" ;;
  *) echo; bad "No command called '$COMMAND'."; cmd_help; exit 2 ;;
esac
