# Copy to .env and fill in, or just run ./install.sh which writes it for you.
#
# Every value below is specific to the machine twocans runs on. Nothing else in
# the repo hardcodes an address, a port or a password.

# Where phones register. Must be an address the phones themselves can reach on
# your network — never localhost, and never a public hostname: SIP and RTP do
# not follow the web address.
SIP_DOMAIN=192.168.1.10

# What a browser uses, and what the provisioning QR code points at. May be a
# domain once you have a certificate.
APP_URL=http://192.168.1.10:8083

HTTP_PORT=8083
TZ=Europe/London

# Phone numbers typed without a country code are assumed to be from here.
DEFAULT_COUNTRY_CODE=44

# Run the app as this user so bind-mounted files stay editable from the host.
HOST_UID=1000
HOST_GID=1000

# --- secrets ------------------------------------------------------------------
# Generate each with: php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
DB_NAME=twocans
DB_USER=twocans
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# Encrypts the SIP trunk's auth token at rest (trunk.auth_token_enc).
# Changing this makes any stored token unreadable.
APP_KEY=

# Asterisk control, kept in sync with docker/asterisk/etc/{ari,manager}.conf.
ARI_USERNAME=twocans
ARI_PASSWORD=change-me
AMI_USERNAME=twocans
AMI_PASSWORD=change-me

# --- speech to text -----------------------------------------------------------
# Runs on this machine; audio never leaves it.
# base = fast, fine for clear speech. small = better on noisy phone audio, ~3x slower.
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_THREADS=4
WHISPER_CPUS=4.0
WHISPER_MEMORY=2g

# --- optional -----------------------------------------------------------------
# SIP and RTP ports. Changing them means reconfiguring every phone, and most
# clients assume 5060 — leave them alone unless you have no choice.
# SIP_PORT=5060
# RTP_PORT_START=10000
# RTP_PORT_END=10100

# HTTPS port published by nginx (the outside world reaches the web UI and
# provisioning links here). Defaults to 443, which certbot and Let's Encrypt
# expect — leave it alone unless something else already holds 443.
# HTTPS_PORT=443

# Cloudflare Tunnel. Use this instead of port forwarding when the box sits behind
# CGNAT or double NAT. Create the tunnel in the Cloudflare dashboard (Zero Trust
# → Tunnels) with a public hostname pointing at http://web:80, paste the token
# here, then start it with:
#   docker compose --profile tunnel up -d
# CLOUDFLARE_TUNNEL_TOKEN=

# Only used by `docker compose --profile tools up -d`.
ADMINER_PORT=8089
